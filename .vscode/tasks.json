{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OCR: tune dense-tile detection",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/tune_dense_detection.py"
      ],
      "dependsOn": [
        "Rust: build vertical slice",
        "OCR: generate quality sample pages (CPU only)",
        "OCR: export page orientation model (CPU only)"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OCR: test line-guided crop orientation",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/check_line_orientation.py"
      ],
      "dependsOn": [
        "Rust: build vertical slice",
        "OCR: generate quality sample pages (CPU only)",
        "OCR: export page orientation model (CPU only)"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OCR: generate quality sample pages (CPU only)",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/generate_document_fixtures.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OCR: build Python wheel",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build_python.ps1",
        "-Install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OCR: profile system and Python library",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "-u",
        "scripts/profile_system.py",
        "${input:memoryProfile}",
        "--python-check",
        "--seconds",
        "${input:throughputSeconds}"
      ],
      "dependsOn": [
        "Rust: build vertical slice",
        "OCR: build Python wheel"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "Rust: 4 GB target throughput (GPU-Z)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/watch_pipeline.ps1",
        "-Vram4GB",
        "-Seconds",
        "${input:throughputSeconds}"
      ],
      "dependsOn": "Rust: build vertical slice",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "Rust: bounded auto-tuned throughput (GPU-Z)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/watch_pipeline.ps1",
        "-Seconds",
        "${input:throughputSeconds}"
      ],
      "dependsOn": "Rust: build vertical slice",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "Rust: build vertical slice",
      "type": "process",
      "command": "${env:USERPROFILE}/.cargo/bin/cargo.exe",
      "args": [
        "build",
        "--release",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CARGO_HOME": "${workspaceFolder}/.cache/cargo"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Rust: upright throughput (GPU-Z)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/watch_rust.ps1",
        "-Seconds",
        "${input:throughputSeconds}"
      ],
      "dependsOn": "Rust: build vertical slice",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "docTR: streaming throughput (GPU-Z)",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "-u",
        "-m",
        "pybaseline.run_throughput",
        "--page",
        "${input:throughputPage}",
        "--seconds",
        "${input:throughputSeconds}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "OCR: benchmark native dense refinement",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "-u",
        "scripts/benchmark_refinement.py",
        "--pages",
        "192"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "dependsOn": [
        "Rust: build vertical slice",
        "OCR: generate quality sample pages (CPU only)"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "OCR: export page orientation model (CPU only)",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/export_orientation_model.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OCR: test native page orientation",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "-u",
        "scripts/check_page_orientation.py"
      ],
      "dependsOn": [
        "Rust: build vertical slice",
        "OCR: export page orientation model (CPU only)",
        "OCR: generate quality sample pages (CPU only)"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "OCR: benchmark native thin recovery",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "-u",
        "scripts/benchmark_thin_recovery.py",
        "--pages",
        "340"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "dependsOn": [
        "Rust: build vertical slice"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "OCR: download public datasets",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/download_public_datasets.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "OCR: prepare public test sets",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/prepare_public_datasets.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "OCR: download public datasets"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "OCR: benchmark public test sets",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/benchmark_public.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "Rust: build vertical slice",
        "OCR: prepare public test sets"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "OCR: score public test sets",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/score_public.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "OCR: benchmark public test sets"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "OCR: report public test sets",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/report_public.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "OCR: score public test sets"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Python: build transfer ZIP",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/package_python.py"
      ],
      "dependsOn": [
        "OCR: build Python wheel"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: check installed CUDA stream",
      "type": "process",
      "command": "${workspaceFolder}/.venv-baseline/Scripts/python.exe",
      "args": [
        "scripts/check_python_stream.py"
      ],
      "dependsOn": [
        "OCR: build Python wheel"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "throughputPage",
      "type": "pickString",
      "description": "Page to repeat through the full OCR pipeline",
      "options": [
        "upright_characters",
        "skew7_characters",
        "skew7_mixed_characters"
      ],
      "default": "upright_characters"
    },
    {
      "id": "throughputSeconds",
      "type": "pickString",
      "description": "Feeding duration (plus model warmup and queue drain)",
      "options": [
        "300",
        "600"
      ],
      "default": "300"
    },
    {
      "id": "memoryProfile",
      "type": "pickString",
      "description": "GPU memory target for calibration",
      "options": [
        "--auto",
        "--vram-4gb"
      ],
      "default": "--auto"
    }
  ]
}
